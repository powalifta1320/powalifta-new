# ============================================================
# POWALIFTA — secrets manifest (single source of truth)
#
# Copy to `.env` (gitignored) and fill in real values, then push them with:
#   ./deploy.sh secrets
#
# No real values live in this tracked template. It exists so re-setup / disaster
# recovery is ONE read instead of hunting through every service dashboard.
# ============================================================

# ---- Supabase edge-function secrets (pushed by ./deploy.sh) ----------------
# Set on the functions via `supabase secrets set`. Each line below maps to the
# function(s) that read it.

# Lemon Squeezy webhook signing secret  → ls-webhook, ls-marketplace-webhook
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Lemon Squeezy API key  → ls-portal (signed customer-portal deep links for
# existing subscribers to manage billing). OPTIONAL: without it, ls-portal
# returns {ok:false} and the client falls back to the no-code email-magic-link
# portal (https://powalifta.lemonsqueezy.com/billing), which needs no secret.
# Create at app.lemonsqueezy.com → Settings → API.
LEMON_SQUEEZY_API_KEY=

# Resend API key  → send-welcome, send-program-assigned, send-invite, send-weekly-digest
RESEND_API_KEY=

# Weekly digest cron gate  → send-weekly-digest (Verify JWT OFF, so it gates on
# this shared secret instead). Any long random string; the cron job must send it
# as `Authorization: Bearer <CRON_SECRET>`. Generate: openssl rand -hex 32
CRON_SECRET=
# Optional: base URL the digest's unsubscribe link points at (token appended).
# Defaults to https://powalifta.com/unsubscribe.html?token= — set only to override.
# UNSUB_BASE=https://powalifta.com/unsubscribe.html?token=

# AI assistant  → ai-chat.  Set at least ONE; set BOTH for Gemini→Groq fallback.
GEMINI_API_KEY=
GROQ_API_KEY=
# Per-user daily AI message cap (optional, function default is 20)
AI_DAILY_CAP=20

# Web Push / VAPID  → send-push.  Generate with: npx web-push generate-vapid-keys
# IMPORTANT: the PUBLIC key must ALSO be pasted into app.js (PowaPush module) —
# it's safe client-side. The private key stays here / on the function only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:powalifta1320@gmail.com

# Native iOS push / APNs  → send-push (rows with platform='ios'). OPTIONAL — until
# set, iOS device tokens are skipped and Web Push is unaffected. From
# developer.apple.com → Keys (create an APNs key): APNS_KEY = the FULL .p8 file
# contents (paste incl. BEGIN/END lines), APNS_KEY_ID = the key's ID, APNS_TEAM_ID
# = your Team ID (Membership page). Bundle id + prod flag have working defaults.
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.powalifta.app
APNS_PRODUCTION=true

# ---- Auto-injected by Supabase (do NOT set) --------------------------------
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to every edge function
# automatically. The SUPABASE_ prefix is reserved, so ./deploy.sh strips any
# SUPABASE_* lines before pushing — they're harmless to leave below.

# ---- Local-only (NOT a function secret) ------------------------------------
# Used by local dev scripts only (seed-demo.mjs). Pass it inline at run time so
# it never lands in function secrets:
#   SUPABASE_SERVICE_ROLE_KEY='...' node seed-demo.mjs
# SUPABASE_SERVICE_ROLE_KEY=
