.AppleDouble
.LSOverride
Icon?

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Local tooling (Claude preview server — not part of the app)
.claude/

# Logs / temp
*.log
.cache/
tmp/

# Local-only dev tools / experiments — viewed on localhost only, must NOT ship to
# main. review.html is the AI-assistant dev harness (CLAUDE.md); index-bold.html is
# the bold-restyle proof used for the polish-vs-bold direction call.
review.html
index-bold.html

# Env / secrets. Real values live in `.env` (ignored); `.env.example` is the
# tracked manifest template. `.env.deploy.tmp` is the throwaway deploy.sh writes.
.env
.env.*
!.env.example

# AI assistant local config (optional, non-secret toggles only). The Gemini key
# lives in the ai-chat edge function's secrets, never here — but keep this local
# override ignored so it's never committed. The .example.js is the safe template.
ai-config.local.js
plate-fx.js

# Capacitor native shells (#32) — build artifacts, regenerated by `cap sync`.
# Source of truth is the web app + native/capacitor.config.json; the platform
# folders + deps are NOT tracked.
native/node_modules/
native/ios/
native/android/
native/package-lock.json
