{
  "name": "powalifta-native",
  "private": true,
  "version": "1.0.0",
  "description": "Capacitor native shell for POWALIFTA — loads the repo's static web app (../) in a native iOS/Android WebView. Built in the cloud (Codemagic) — no local Xcode needed.",
  "scripts": {
    "copyweb": "bash copy-web.sh",
    "sync": "npm run copyweb && cap sync",
    "add:ios": "cap add ios",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/push-notifications": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "@capacitor/haptics": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@capacitor/assets": "^3.0.5"
  }
}
